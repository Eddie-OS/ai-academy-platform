<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  任务中心只读查询。逾期是派生表达式（需求 13.1.1 第 9 项），不落库列、不靠定时任务刷新。
-->
<mapper namespace="com.aiacademy.aggregate.worklist.repository.TaskQueryMapper">

    <sql id="overdueExpr">
        (t.due_date &lt; CURRENT_DATE
         AND t.task_state IN (#{pending}, #{inProgress}))
    </sql>

    <sql id="taskWhere">
        WHERE t.deleted = FALSE
        <if test="q.ownerNo != null and q.ownerNo != ''">
            AND t.owner_no = #{q.ownerNo}
        </if>
        <if test="q.taskState != null and q.taskState != ''">
            AND t.task_state = #{q.taskState}
        </if>
        <if test="q.taskType != null and q.taskType != ''">
            AND t.task_type = #{q.taskType}
        </if>
        <if test="q.overdueOnly != null and q.overdueOnly">
            AND <include refid="overdueExpr"/>
        </if>
    </sql>

    <select id="selectPage" resultType="com.aiacademy.aggregate.worklist.domain.TaskListItem">
        SELECT t.id, t.title, t.task_type, t.object_type, t.object_id,
               t.owner_no, t.owner_name, t.due_date, t.task_state, t.derive_type,
               <include refid="overdueExpr"/> AS overdue,
               t.created_at, t.last_state_changed_at
          FROM sys_task t
        <include refid="taskWhere"/>
         ORDER BY t.due_date ASC NULLS LAST, t.id DESC
         LIMIT #{q.pageSize} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM sys_task t
        <include refid="taskWhere"/>
    </select>

</mapper>

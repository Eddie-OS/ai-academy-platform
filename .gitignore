# 构建产物
backend/**/build/
backend/.gradle/
frontend/dist/
frontend/node_modules/

# 测试产物。Playwright 每跑一次都会重写这两个目录：report 是 HTML 报告，
# test-results 里是失败时的 trace 与截图，都是几 MB 级的二进制，不属于源码
frontend/playwright-report/
frontend/test-results/

# scripts/shot-product.mjs 与 probe-zoom.mjs 的截图输出目录
frontend/shots/

# 把测试与检查命令的控制台输出重定向到文件时留下的草稿
backend/backend-test.txt
frontend/full-test.txt
frontend/lecturer-test.txt
frontend/recheck.txt
frontend/state-literal-violations.txt
frontend/crs-measure.mjs

# 敏感信息（规则 SEC4／CF：口令与凭据不进代码库）
# .env.example 是不含密值的模板，必须留在库里：服务器初始化要照它填 .env
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
cookies.txt

# 归档包：与同名目录内容重复，仅用于对外传输
*.rar
*.zip
*.7z

# IDE
.idea/
*.iml
.vscode/
*.swp

# 日志与本地数据
*.log
logs/
data/

# 操作系统
.DS_Store
Thumbs.db

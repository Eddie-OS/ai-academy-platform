# 生产环境变量模板。复制为 .env 后填写，.env 不进 git。
#
# 规则 SEC5：两个共享账号的口令必须是 BCrypt 哈希，不得明文。
# 规则 SEC6：凭据分发范围就是数据可见范围，系统内没有第二道防线。
#
# 生成口令哈希（在 backend 目录下执行）：
#   .\gradlew.bat :app:printPasswordHash -Ppassword='你的口令'
#
# 命令会打印两行，本文件必须填「.env 专用」那一行——里面的 $ 已转义成 $$。
# 原因：BCrypt 哈希含 $，而 Docker Compose 会把这里的 $xxx 当变量插值成空串，
# 得到一个前缀完好、中间少一段的残缺哈希。应用照样能启动，但登录永远失败。
# 应用启动时会按完整长度校验哈希结构，填错会直接启动失败并给出这条提示。

DB_NAME=aiacademy
DB_USER=aiacademy
DB_PASSWORD=

OPERATOR_PASSWORD_HASH=
VIEWER_PASSWORD_HASH=

# --- 宿主机目录（生产机为 Windows，BLOCK-05）---------------------------------
# 必须是 Windows 路径。写成 /data/... 会落进 WSL2 虚拟机内部，
# 宿主机上的备份脚本与外置硬盘都访问不到。
# 盘符请避开系统盘，留足 2TB 规划里的附件空间。
ATTACHMENT_DIR=D:\aiacademy\attachments
LOG_DIR=D:\aiacademy\logs

# --- 备份脚本用（BK1～BK5，scripts\backup.ps1）-------------------------------
# 外置硬盘的盘符。BK4 要求平时不挂载：备份脚本会在结束时移除盘符访问路径，
# 因此这里填的盘符只在备份窗口内存在。
BACKUP_DRIVE=E:
# 外置硬盘的磁盘编号（Get-Disk 查看）。留空则跳过挂载／卸载，按盘符已存在处理。
BACKUP_DISK_NUMBER=
# 备份状态文件，app 读它决定首页是否显示红色告警 Banner（BK5）
BACKUP_STATUS_FILE=D:\aiacademy\backup-status.json
